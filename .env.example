PORT=5000

# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

DATABASE_PATH=./dojodesk.db
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://app.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OPTIONAL — set this ONLY when you need to bootstrap the very first admin account.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Remove from env after first admin is created.
# INIT_ADMIN_SECRET=
