PORT=5000

# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

DATABASE_PATH=./dojodesk.db
NODE_ENV=development

# CORS — any *.dragondeskapp.com subdomain is allowed automatically.
# Use ALLOWED_ORIGINS only for additional domains (e.g. a custom domain or localhost).
# Comma-separated, no trailing slashes.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# SSL — set to "false" only when using Railway's internal DATABASE_PRIVATE_URL
# (self-signed cert on private network). Leave unset (defaults to true) for all
# other production databases.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# OPTIONAL — set this ONLY when you need to bootstrap the very first admin account.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Remove from env after first admin is created.
# INIT_ADMIN_SECRET=
